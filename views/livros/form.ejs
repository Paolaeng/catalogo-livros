<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= tituloPagina %></title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
  <main class="container">
    <header class="page-header">
      <div>
        <h1><%= tituloPagina %></h1>
        <p>Preencha os dados principais do livro.</p>
      </div>
      <a class="button secondary" href="/livros">Voltar</a>
    </header>

    <form class="book-form" action="<%= acao %>" method="post">
      <label for="titulo">Título</label>
      <input id="titulo" name="titulo" type="text" value="<%= livro.titulo || '' %>">
      <% if (erros && erros.titulo) { %>
        <span style="color: #dc2626; font-size: 0.85rem;"><%= erros.titulo %></span>
      <% } %>

      <label for="autor">Autor</label>
      <input id="autor" name="autor" type="text" value="<%= livro.autor || '' %>">
      <% if (erros && erros.autor) { %>
        <span style="color: #dc2626; font-size: 0.85rem;"><%= erros.autor %></span>
      <% } %>

      <label for="ano">Ano</label>
      <input id="ano" name="ano" type="number" value="<%= livro.ano || '' %>">
      <% if (erros && erros.ano) { %>
        <span style="color: #dc2626; font-size: 0.85rem;"><%= erros.ano %></span>
      <% } %>

      <label for="categoria">Categoria</label>
      <input id="categoria" name="categoria" type="text" value="<%= livro.categoria || '' %>" placeholder="Ex: Ficção, Tecnologia">

      <label for="statusLeitura">Situação da Leitura</label>
      <select id="statusLeitura" name="statusLeitura" style="padding: 8px; border-radius: 6px; border: 1px solid #bbb;">
        <option value="Quero ler" <%= livro.statusLeitura === 'Quero ler' ? 'selected' : '' %>>Quero ler</option>
        <option value="Lendo" <%= livro.statusLeitura === 'Lendo' ? 'selected' : '' %>>Lendo</option>
        <option value="Concluído" <%= livro.statusLeitura === 'Concluído' ? 'selected' : '' %>>Concluído</option>
      </select>

      <button class="button" type="submit">Salvar</button>
    </form>
  </main>
</body>
</html>